{
  "name": "@rekt-ink/protocol",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "files": [
    "src",
    "schema",
    "compiler"
  ],
  "types": "./src/constants.d.ts",
  "exports": {
    ".": {
      "types": "./src/constants.d.ts",
      "import": "./src/constants.mjs"
    },
    "./server": "./src/index.mjs",
    "./challenge": {
      "types": "./src/challenge.d.ts",
      "import": "./src/challenge-hardened.mjs"
    },
    "./acceptance-manifest": {
      "types": "./src/acceptance-manifest.d.ts",
      "import": "./src/acceptance-manifest.mjs"
    },
    "./test-arena-execution": {
      "types": "./src/test-arena-execution.d.ts",
      "import": "./src/test-arena-execution.mjs"
    },
    "./settlement-adapter": {
      "types": "./src/settlement-adapter.d.ts",
      "import": "./src/settlement-adapter.mjs"
    },
    "./compiler": {
      "types": "./src/compiler.d.ts",
      "import": "./src/compiler.mjs"
    },
    "./compiler-provider": {
      "types": "./src/compiler-provider.d.ts",
      "import": "./src/compiler-provider.mjs"
    },
    "./compiler-provider-egress": "./src/compiler-provider-egress.mjs",
    "./schema/*": "./schema/*"
  },
  "publishConfig": {
    "access": "public"
  }
}
