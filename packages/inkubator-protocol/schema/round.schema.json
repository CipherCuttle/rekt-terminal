{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rekt.ink/schemas/inkubator/round/0.1",
  "title": "INK(CUBATOR) Round",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roundId", "title", "status", "constraint", "rules"],
  "properties": {
    "schemaVersion": {"const": "inkubator.round/0.1"},
    "roundId": {"type": "string", "pattern": "^R[A-Z0-9-]{2,31}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"enum": ["DRAFT", "OPEN", "BUILDING", "SHIP_WINDOW", "CLOSED", "ARCHIVED"]},
    "constraint": {"type": "string", "minLength": 1, "maxLength": 280},
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingUrlRequired", "demoRequired", "aiAllowed"],
      "properties": {
        "workingUrlRequired": {"type": "boolean"},
        "demoRequired": {"type": "boolean"},
        "aiAllowed": {"type": "boolean"}
      }
    }
  }
}
