{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rekt.ink/schema/compiler-state.schema.json",
  "title": "REKT Inkubator CompilerState V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "source_intent",
    "project_fingerprint",
    "knowledge",
    "requirements",
    "production_envelope",
    "risk_profile",
    "quality_profile",
    "blueprint_candidates",
    "selected_blueprint",
    "causal_facts",
    "sensitivity_points",
    "outcome_contract_candidate",
    "delivery_contract_candidate",
    "preferences",
    "reference_architecture_candidate",
    "acceptance_plan",
    "questions",
    "findings",
    "unresolved_decisions",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "inkubator.compiler-state/1.0"},
    "compiler_version": {"const": "inkubator.compiler/1.0"},
    "source_intent": {"type": "string", "minLength": 1},
    "project_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_class", "signals"],
      "properties": {
        "project_class": {"type": "string", "minLength": 1},
        "signals": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "knowledge": {"type": "array", "items": {"$ref": "#/$defs/knowledge"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "production_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "facts"],
      "properties": {
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/causalFact"}}
      }
    },
    "risk_profile": {"$ref": "#/$defs/profile"},
    "quality_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["STANDARD", "ELEVATED", "STRICT"]},
        "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "blueprint_candidates": {"type": "array", "items": {"$ref": "#/$defs/blueprintRef"}},
    "selected_blueprint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blueprintRef"}]},
    "causal_facts": {"type": "array", "items": {"$ref": "#/$defs/causalFact"}},
    "sensitivity_points": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "outcome_contract_candidate": {"$ref": "#/$defs/criteriaContainer"},
    "delivery_contract_candidate": {"$ref": "#/$defs/criteriaContainer"},
    "preferences": {"type": "object"},
    "reference_architecture_candidate": {"type": "object"},
    "acceptance_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules"],
      "properties": {"modules": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
    },
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unresolved_decisions": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "status": {"enum": ["READY", "NEEDS_DECISION", "UNSUPPORTED"]}
  },
  "$defs": {
    "scalar": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}]},
    "inputProvenance": {"enum": ["SOURCE", "MODEL_PROPOSAL", "ORGANIZER_ACCEPTED"]},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "provenance"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/scalar"},
        "provenance": {"$ref": "#/$defs/inputProvenance"}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "material", "provenance"],
      "properties": {
        "kind": {"enum": ["KNOWN", "ASSUMED", "UNKNOWN"]},
        "key": {"type": "string", "minLength": 1},
        "material": {"type": "boolean"},
        "value": {"$ref": "#/$defs/scalar"},
        "provenance": {"enum": ["SOURCE", "MODEL_PROPOSAL", "ORGANIZER_ACCEPTED", "DETERMINISTIC_RULE"]}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "mandatory", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "mandatory": {"type": "boolean"},
        "provenance": {"enum": ["SOURCE", "MODEL_PROPOSAL", "ORGANIZER_ACCEPTED", "DETERMINISTIC_RULE"]}
      }
    },
    "criteriaContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {"criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}}}
    },
    "causalFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "provenance", "rule_id"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/scalar"},
        "provenance": {"const": "DETERMINISTIC_RULE"},
        "rule_id": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "blueprintRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "blocking", "rule_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "rule_id": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "rule_id"],
      "properties": {
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
