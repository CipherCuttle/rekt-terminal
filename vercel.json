{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "services": {
    "web": {
      "root": "apps/web/"
    },
    "api": {
      "root": "apps/api/",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": { "service": "api" }
    },
    {
      "source": "/v1/:path*",
      "destination": { "service": "api" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "web" }
    }
  ]
}
